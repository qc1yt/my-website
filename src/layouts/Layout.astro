---
// ページ全体の共通の枠組み(Header, Navigation, Font等)を定義する．

import '../styles/style.css';
import { getCollection } from 'astro:content';
import { ViewTransitions } from 'astro:transitions';

// 全セクションのデータを取得して最新順に並べる（エラー時は空配列）
const allDiary = await getCollection('diary').then(entries => entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())).catch(() => []);
const allTech = await getCollection('tech').then(entries => entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())).catch(() => []);
const allSoftware = await getCollection('software').then(entries => entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())).catch(() => []);
const allPapers = await getCollection('papers').then(entries => entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())).catch(() => []);
---

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <ViewTransitions />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="This is a personal knowledge base compiling my daily notes.">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Noto+Sans+JP:wght@300;400;600&display=swap');
        @import url('https://fonts.cdnfonts.com/css/latin-modern-roman');
    </style>
    <style is:global>
        /* カレンダー用のスタイル */
        .sidebar-calendar {
            margin-top: 2rem;
            padding: 1rem;
            background: rgba(255, 255, 255, 0.05); /* 背景になじむ半透明 */
            border-radius: 8px;
            font-size: 0.85rem;
        }
        .calendar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            font-weight: 600;
        }
        .calendar-header button {
            background: none;
            border: none;
            color: inherit;
            cursor: pointer;
            font-size: 1.2rem;
        }
        .calendar-weekdays {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            text-align: center;
            font-weight: 600;
            margin-bottom: 0.5rem;
            opacity: 0.6;
            font-size: 0.7rem;
        }
        .calendar-days {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 4px;
            text-align: center;
        }
        .cal-day {
            padding: 0.25rem 0;
            border-radius: 4px;
        }
        .cal-day.today {
            background: var(--text-primary, #333);
            color: #fff;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="custom-cursor" id="cursor"></div>

    <svg class="noise-overlay" xmlns="http://www.w3.org/2000/svg">
        <filter id="noiseFilter">
            <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch"/>
        </filter>
        <rect width="100%" height="100%" filter="url(#noiseFilter)"/>
    </svg>

    <header class="global-header glass-effect">
        <nav class="nav-container">
            <div class="logo"><a href="/">一尺八寸の余白</a></div>
            <ul class="nav-links">
                <li><a href="/#diary">01 DIARY</a></li>
                <li><a href="/#tech">02 TECH</a></li>
                <li><a href="/#software">03 SOFTWARE</a></li>
                <li><a href="/#papers">04 PAPERS</a></li>
            </ul>
        </nav>
    </header>

    <div class="layout-wrapper">
        <aside class="sidebar">
            <a href="/archive" class="contents-button hover-trigger" id="toc-button" style="color: #ffffff;">
                INDEX / CONTENTS <span class="arrow">→</span>
            </a>
            
            <ul class="sidebar-nav">

            <div class="sidebar-calendar">
                <div class="calendar-header">
                    <button id="prev-month">‹</button>
                    <div id="month-year"></div>
                    <button id="next-month">›</button>
                </div>
                <div class="calendar-weekdays">
                    <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
                </div>
                <div class="calendar-days" id="calendar-days"></div>
            </div>
        </aside>
                <li>
                    <a href="/#diary" style="color: var(--text-secondary);">01 DIARY</a>
                    {allDiary.length > 0 && (
                        <ul class="sub-nav">
                            {allDiary.map(entry => (
                                <li><a href={`/diary/${entry.slug}`}>{entry.data.title}</a></li>
                            ))}
                        </ul>
                    )}
                </li>

                <li>
                    <a href="/#tech" style="color: var(--text-secondary);">02 TECH NOTES</a>
                    {allTech.length > 0 && (
                        <ul class="sub-nav">
                            {allTech.map(entry => (
                                <li><a href={`/tech/${entry.slug}`}>{entry.data.title}</a></li>
                            ))}
                        </ul>
                    )}
                </li>

                <li>
                    <a href="/#software" style="color: var(--text-secondary);">03 SOFTWARE</a>
                    {allSoftware.length > 0 && (
                        <ul class="sub-nav">
                            {allSoftware.map(entry => (
                                <li><a href={`/software/${entry.slug}`}>{entry.data.title}</a></li>
                            ))}
                        </ul>
                    )}
                </li>

                <li>
                    <a href="/#papers" style="color: var(--text-secondary);">04 PAPERS</a>
                    {allPapers.length > 0 && (
                        <ul class="sub-nav">
                            {allPapers.map(entry => (
                                <li><a href={`/papers/${entry.slug}`}>{entry.data.title}</a></li>
                            ))}
                        </ul>
                    )}
                </li>
            </ul>
        </aside>
        
        <div class="main-content">
            <slot />
        </div>
    </div>

<script is:inline>
    document.addEventListener('astro:page-load', () => {
        // --- 1. 目次ボタンのトグル処理 ---
        const contentsBtn = document.getElementById('toc-button');
        if (contentsBtn) {
            const currentPath = window.location.pathname;
            // 現在が /archive の場合、ボタンを「トップに戻る」に変更
            if (currentPath === '/archive' || currentPath === '/archive/') {
                contentsBtn.href = '/';
                contentsBtn.innerHTML = 'CLOSE CONTENTS <span class="arrow">←</span>';
            } else {
                contentsBtn.href = '/archive';
                contentsBtn.innerHTML = 'INDEX / CONTENTS <span class="arrow">→</span>';
            }
        }

        // --- 2. カレンダーの生成処理 ---
        const monthYear = document.getElementById('month-year');
        const calendarDays = document.getElementById('calendar-days');
        const prevBtn = document.getElementById('prev-month');
        const nextBtn = document.getElementById('next-month');

        let currentDate = new Date();

        function renderCalendar(date) {
            if (!calendarDays || !monthYear) return;
            calendarDays.innerHTML = '';
            
            const year = date.getFullYear();
            const month = date.getMonth();
            
            monthYear.textContent = `${year}.${(month + 1).toString().padStart(2, '0')}`;
            
            const firstDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            
            // 月の初日までの空白を作成
            for (let i = 0; i < firstDay; i++) {
                const emptyDiv = document.createElement('div');
                calendarDays.appendChild(emptyDiv);
            }
            
            // 日付を作成
            const today = new Date();
            for (let i = 1; i <= daysInMonth; i++) {
                const dayDiv = document.createElement('div');
                dayDiv.textContent = i;
                dayDiv.classList.add('cal-day');
                // 今日の日付をハイライト
                if (year === today.getFullYear() && month === today.getMonth() && i === today.getDate()) {
                    dayDiv.classList.add('today');
                }
                calendarDays.appendChild(dayDiv);
            }
        }

        if (calendarDays) {
            renderCalendar(currentDate);
            prevBtn?.addEventListener('click', () => {
                currentDate.setMonth(currentDate.getMonth() - 1);
                renderCalendar(currentDate);
            });
            nextBtn?.addEventListener('click', () => {
                currentDate.setMonth(currentDate.getMonth() + 1);
                renderCalendar(currentDate);
            });
        }

        // --- 3. 既存のスクロールアニメーション処理 ---
        const reveals = document.querySelectorAll('.reveal');
        const revealOnScroll = () => {
            const windowHeight = window.innerHeight;
            const elementVisible = 100;
            reveals.forEach(reveal => {
                const elementTop = reveal.getBoundingClientRect().top;
                if (elementTop < windowHeight - elementVisible) {
                    reveal.classList.add('active');
                }
            });
        };

        window.addEventListener('scroll', revealOnScroll);
        setTimeout(revealOnScroll, 100); // 初期表示
    });
</script>

</body>

</html>
